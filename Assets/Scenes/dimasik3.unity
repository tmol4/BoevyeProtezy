  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Novel_manager
  background: {fileID: 2005874917}
  dialoguePanel: {fileID: 328585445}
  dialogueText: {fileID: 427459168}
  perexod: {fileID: 0}
  backgrounds:
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  - {fileID: 6401310495371943747, guid: a66c56c86a12b0c31a4d222f8a45fcc8, type: 3}
  dialogues:
  - " \u0414\u0435\u043D\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0441\u043B\u0443\u0436\u0431\u044B. \u0412\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u043D\u043E\u0442\u044B \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435 \u0432\u0435\u0447\u0435\u0440\u043E\u043C. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0441\u043F\u0435\u0432\u043A\u0430."
  - "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u0433\u043E\u0441\u043B\u0443\u0436\u0435\u043D\u0438\u0435. "
  - "\u041A \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043E\u0434\u043D\u0430 \u0438\u0437 \u043F\u0435\u0432\u0447\u0438\u0445, \u0422\u0430\u0442\u044C\u044F\u043D\u0430. "
  - "\u0422\u0430\u0442\u044C\u044F\u043D\u0430: \u0410 \u0443 \u0442\u0435\u0431\u044F \u043D\u0435\u043F\u043B\u043E\u0445\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u0438\u0440\u0438\u0436\u0438\u0440\u043E\u0432\u0430\u0442\u044C. \u042F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E, \u0434\u0443\u043C\u0430\u044E \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0445\u043E\u0440 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u041F\u0430\u0441\u0445\u0438. \u0421 \u0442\u0430\u043A\u0438\u043C \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u043C \u0440\u0435\u0433\u0435\u043D\u0442\u043E\u043C \u043C\u043D\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u044C \u043E \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430\u0445. "
  - "\u0412 \u0432\u0430\u0448\u0435\u043C \u0445\u043E\u0440\u0435 \u0442\u0435\u043F\u0435\u0440\u044C 8 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0435\u0433\u0435\u043D\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0430\u043C \u043D\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0433\u043E\u043B\u043E\u0441\u043E\u0432 \u0438 \u0442\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439 \u043D\u0430 9 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0423 \u0432\u0430\u0441 \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0432\u0441\u0451 \u043F\u043E \u043D\u043E\u0432\u043E\u0439 \u043A \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430\u043C. ! \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430 \u0445\u043E\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0422\u0430\u0442\u044C\u044F\u043D\u0443 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u041F\u0430\u0441\u0445\u0438.\u0412\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438\u0441\u043A\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u0433\u043E\u043B\u043E\u0441 \u0441\u0440\u0435\u0434\u0438 \u043F\u0440\u0438\u0445\u043E\u0436\u0430\u043D. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u0441\u044C \u0432 \u0446\u0435\u0440\u043A\u0432\u0438. \u041C\u043E\u0436\u0435\u0442 \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0439 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u043A \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435? "
  - "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  - "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  - "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  - "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  - "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  choicePanel: {fileID: 818362131}
  fadeCanvasGroup: {fileID: 1948298415}
  fadeDuration: 1.5
